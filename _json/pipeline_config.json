        "cut_level_id": "cut",
        "work_level_id": "work",
        "cache_path_mode": "custom",
        "cache_relative_path": "cache",
        "depth_map": {
          "scene_depth": 4,
          "cut_depth": 5,
          "process_depth": 6,
          "file_depth": 7
        }
      },
      "scene_filename_rules": {
        "scene_token_pattern": "C\\d+",
        "cut_token_pattern": "\\d+",
        "version_pattern": "v\\d+",
        "example": "C02_1_v01.ma"
      },
      "cache": {
        "root_mode": "custom",
        "match_mode": "by_asset_id",
        "extensions": [
          ".abc",
          ".usd"
        ]
      },
      "output": {
        "version_folder_mode": "v###",
        "default_version_digits": 2,
        "file_slot_prefix_template": "{scene_token}_{cut_token}_{layer}_"
      }
