  "profiles": {
    "standard_blender_scene_cut": {
      "description": "Standard project profile used by THE_TRAP, ARBOBION, BTS, DSC, FUZZ.",
      "dcc": {
        "default": "blender",
        "blender": {
          "scene_extensions": [
            ".blend"
          ],
          "work_dirs": [
            "ren",
            "cfx",
            "fx"
          ]
        },
        "maya": {
          "scene_extensions": [
            ".ma",
            ".mb"
          ]
        }
      },
      "scene_browser": {
        "levels": [
          {
            "id": "scene",
            "label": "Scene"
          },
          {
            "id": "cut",
            "label": "Cut",
            "parent_level": "scene"
          },
          {
            "id": "work",
            "label": "Work",
            "parent_level": "cut",
            "fixed_options": [
              "ren",
              "cfx",
              "fx"
            ],
            "default": "ren"
          }
        ],
        "file_level_id": "work",
        "file_extensions": [
          ".blend"
        ]
      },
      "scene_structure": {
        "identifier_source": "folder_depth",
        "scene_level_id": "scene",
        "cut_level_id": "cut",
        "work_level_id": "work",
        "cache_path_mode": "relative_to_work",
        "cache_relative_path": "cache"
      },
      "assets": {
        "default_categories": [
          "ch",
          "bg",
          "prop"
        ],
        "default_geometry_root_hint": "geo"
      },
      "cache": {
        "root_mode": "relative_to_work",
        "root_template": "{work_path}/cache",
        "file_template": "{project_prefix}_{scene}_{cut}_{category}_{asset_id}.usd",
        "match_mode": "by_asset_id_and_category",
        "extensions": [
          ".usd"
        ]
      },
      "output": {
        "version_folder_mode": "v###",
        "default_version_digits": 3,
        "file_slot_prefix_template": "{scene}_{cut}_{layer}_"
      }
    },
    "maya_asset_project": {
      "description": "Legacy Maya asset project profile inferred from CKR-style structure.",
      "dcc": {
        "default": "maya",
        "maya": {
          "scene_extensions": [
            ".ma",
