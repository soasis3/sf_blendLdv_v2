      "scene_structure": {
        "identifier_source": "folder_depth",
        "scene_level_id": "scene",
        "cut_level_id": "cut",
        "work_level_id": "work",
        "cache_path_mode": "relative_to_work",
        "cache_relative_path": "cache"
